# Application: set per local/test/deployment environment; never use production secrets here.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Public HTTPS origin for backend-verifiable evidence references in deployed environments.
APP_ORIGIN=http://localhost:3000
# Next hosts the API at /api. For a separate API, set PUBLIC_API_URL to its full base URL.
PUBLIC_API_PATH=/api
PUBLIC_API_URL=
# Browser-visible URL for the API. It contains no credentials.
NEXT_PUBLIC_API_BASE_URL=/api
API_PORT=4000
# MongoDB Atlas URI and database used by API authentication, NFT profiles and Mongo indexes.
MONGODB_URI=mongodb://127.0.0.1:27017/chog_evolution?replicaSet=rs0
MONGODB_DATABASE=chog_evolution
# Put MONGODB_TEST_URI in ignored .env.integration for isolated acceptance tests.
# Runners create, mark and remove only their own random chog_test_ database.
MONGODB_TEST_URI=
# The public application uses real wallet and adjudication flows only.
# Optional server-only key for quest configuration and manual review administration.
QUEST_ADMIN_API_KEY=

# Anonymous public pages are the default; no OAuth or API key is required.
# Set disabled only when public-source availability cannot be supported at release.
X_SOURCE_MODE=public_page
# Optional legacy provider, used only with explicit X_SOURCE_MODE=api.
X_API_BEARER_TOKEN=
# Optional GitHub API token increases the public repository lookup rate limit.
GITHUB_PUBLIC_READ_TOKEN=

# Persistent worker timing and database lease; GitHub Actions invokes one bounded tick every 5 minutes.
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_MS=180000
WORKER_BATCH_SIZE=10

# Monad testnet configuration. CHOG Evolution Demo was deployed and verified on 2026-10-18.
MONAD_TESTNET_CHAIN_ID=10143
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
DEMO_COLLECTION_ADDRESS=0x45119A32ca6C4d67424401dA92Abe4EC6c83f8Ce
NEXT_PUBLIC_MONAD_TESTNET_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_TESTNET_EXPLORER_URL=https://testnet.monadscan.com
NEXT_PUBLIC_DEMO_COLLECTION_ADDRESS=0x45119A32ca6C4d67424401dA92Abe4EC6c83f8Ce
# Owner-only one-time demo metadata setup; used only with metadata:check -- --apply.
MONAD_OWNER_PRIVATE_KEY=

# Monad mainnet original Chog companion profiles. Public values; verify on chain at runtime.
MONAD_MAINNET_CHAIN_ID=143
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
ORIGINAL_CHOG_COLLECTION_ADDRESS=0xc96d31F8626c6D03Fae5dCD3d61e3FB9F4a73763
NEXT_PUBLIC_MONAD_MAINNET_CHAIN_ID=143
NEXT_PUBLIC_MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_ORIGINAL_CHOG_COLLECTION_ADDRESS=0xc96d31F8626c6D03Fae5dCD3d61e3FB9F4a73763
# Upper token ID bound for ownership discovery when ERC-721 enumeration is unavailable.
ORIGINAL_COLLECTION_MAX_TOKEN_ID=1969

# Optional JSON event targets supplement the built-in Monad mainnet activity scan.
# Scans queue eligible immutable proof for GenLayer. Only finalized decisions award XP.
SCAN_MAX_BLOCK_RANGE=10000
SCAN_CHUNK_BLOCKS=500
SCAN_WALLET_BLOCKS_PER_REQUEST=32
SCAN_WALLET_LOOKBACK_BLOCKS=256
MONAD_FINALITY_BLOCKS=4
MONAD_SCAN_TARGETS=[]

# GenLayer supported network name, RPC override, deployed adjudicator and dedicated funded signer.
# Required by GitHub Actions cron workflow as repository variables/secrets.
GENLAYER_NETWORK=studionet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=0x73Bd1106FFa722cf8e71A04f612ee868CDCd2396
GENLAYER_PRIVATE_KEY=

# Optional Gemini rendering. Without a key, finalized traits use the built-in real artwork renderer.
GEMINI_API_KEY=
# Current Google AI SDK image model; no Gemini request occurs without a server API key.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ASSET_STORAGE_ENDPOINT=
ASSET_STORAGE_BUCKET=
ASSET_STORAGE_ACCESS_KEY=
ASSET_STORAGE_SECRET_KEY=

# User-authorized supplied project references, pinned by content and revision.
CHOG_REFERENCE_REPOSITORY_URL=https://github.com/TS-mfon/chog-evolution
CHOG_REFERENCE_COMMIT=b1b273b58c37a09d96ff98de08a552df6623bd78
