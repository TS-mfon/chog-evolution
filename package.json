{
  "name": "chog-evolution",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/concurrently/dist/bin/concurrently.js -k -n web,api,worker \"npm run dev --workspace=@chog/web\" \"npm run dev --workspace=@chog/api\" \"npm run dev --workspace=@chog/worker\"",
    "build": "npm run build --workspace=@chog/api && npm run build --workspace=@chog/worker && npm run build --workspace=@chog/web",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "test:browser": "node scripts/verify-browser.mjs",
    "mcp:react-bits": "npm exec --workspace=@chog/web -- shadcn@latest mcp",
    "metadata:check": "node --env-file-if-exists=.env scripts/configure-demo-metadata.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx services/api/src/migrate.ts",
    "test:integration": "node --env-file-if-exists=.env.integration scripts/test-integration.mjs",
    "test:browser:persistence": "node --env-file-if-exists=.env.integration --import tsx scripts/verify-browser-persistence.mts",
    "test:browser:all": "npm run test:browser && npm run test:browser:persistence"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "1.64.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "genlayer-js-stable": "npm:genlayer-js@1.1.8"
  }
}
