{
  "name": "chog-evolution",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": ["apps/*", "services/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n web,api,worker \"npm run dev --workspace=@chog/web\" \"npm run dev --workspace=@chog/api\" \"npm run dev --workspace=@chog/worker\"",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0"
  }
}
