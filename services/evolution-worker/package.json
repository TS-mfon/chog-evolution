{
  "name": "@chog/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build --workspace=@chog/api && tsc",
    "check": "tsc --noEmit",
    "test": "npm run build --workspace=@chog/api && node --import tsx --test --test-isolation=none --test-reporter=tap test/*.test.ts",
    "start": "node dist/index.js",
    "once": "node dist/index.js --once"
  },
  "dependencies": {
    "@chog/api": "0.1.0",
    "@chog/evolution-rules": "0.1.0",
    "@chog/art-composition": "0.1.0",
    "@chog/shared-types": "0.1.0",
    "@google/genai": "^2.30.0",
    "genlayer-js-stable": "npm:genlayer-js@1.1.8",
    "mongodb": "^7.7.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
